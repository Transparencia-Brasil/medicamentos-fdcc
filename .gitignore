# History files
.Rhistory
.Rapp.history

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

/.quarto/
.vscode/settings.json

# Configuração local
/.env
/.venv/

# saidas json
*.json

# Arquivos locais da análise inicial de CSV e API
/tasks/analise-inicial-csv-e-api/**/.venv/
/tasks/analise-inicial-csv-e-api/**/__pycache__/
/tasks/analise-inicial-csv-e-api/**/.ipynb_checkpoints/
/tasks/analise-inicial-csv-e-api/**/.env.local
/tasks/analise-inicial-csv-e-api/output/*.json
/tasks/analise-inicial-csv-e-api/inputs/*.csv
/tasks/analise-inicial-csv-e-api/inputs/*.jsonl.gz

# Base de compras usada na análise local
/tasks/analise-inicial-csv-e-api/docs/inputs/brazil_compras_2025.jsonl.gz

# Artefatos gerados pelo pipeline OCDS (dados, ZIPs e logs)
/tasks/mapeamento-ocds/output/

# Coletor de contratações: downloads temporários e saídas
/tasks/coleta-contratacoes/tmp/
/tasks/coleta-contratacoes/outputs/*
!/tasks/coleta-contratacoes/outputs/.gitkeep
/tasks/coleta-contratacoes/**/__pycache__/
